{
    "name": "d2r-reimagined-website",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "dev": "vite dev --port 9500",
        "build": "vite build",
        "preview": "vite preview --port 9500",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.3",
        "flowbite": "^4.0.2",
        "flowbite-svelte": "^1.33.1",
        "flowbite-svelte-icons": "^3.1.0",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vitest": "^3.0.0"
    }
}
